# ─────────────────────────────────────────────────────────────────
# Storage Provider
# Controls which file storage backend is used.
# Supported values: google | onedrive
# ─────────────────────────────────────────────────────────────────
VITE_STORAGE_PROVIDER=google

# Comma-separated list of enabled providers (used for future multi-provider UI).
# Example: VITE_STORAGE_ENABLED=google,onedrive
VITE_STORAGE_ENABLED=google

# ─────────────────────────────────────────────────────────────────
# Google Drive (active when VITE_STORAGE_PROVIDER=google)
# ─────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ─────────────────────────────────────────────────────────────────
# Microsoft OneDrive (active when VITE_STORAGE_PROVIDER=onedrive)
# ─────────────────────────────────────────────────────────────────
# VITE_ONEDRIVE_CLIENT_ID=your-azure-app-client-id
# VITE_ONEDRIVE_TENANT_ID=common
# VITE_ONEDRIVE_SCOPE=Files.ReadWrite User.Read openid profile
# VITE_ONEDRIVE_FOLDER_ID=your-onedrive-folder-item-id

# ─────────────────────────────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────
# QR Code Signing Secret
# Used for HMAC-SHA256 signing of entity QR codes (locations, vehicles, staff).
# Change this value per deployment to invalidate all previously printed QR codes.
# Use a long random string (32+ characters recommended).
# ─────────────────────────────────────────────────────────────────
VITE_QR_SIGNING_SECRET=change-this-to-a-long-random-secret-string
# Enable/disable datetime-based key scoping by default.
# true  = time-scoped QR tokens (recommended)
# false = static-secret QR tokens unless call overrides noTimeScope
VITE_QR_ENABLE_TIME_SCOPE=true
# Maximum allowed token age in minutes for time-scoped QR tokens.
VITE_QR_TOKEN_MAX_AGE_MINUTES=30

# -----------------------------------------------------------------------------
# n8n Webhooks
# -----------------------------------------------------------------------------
# Staff Excel Upload webhook endpoint
VITE_N8N_STAFF_EXCEL_WEBHOOK_URL=https://your-n8n-host/webhook/staff-excel-upload
# Product Excel Upload webhook endpoint
VITE_N8N_PRODUCT_EXCEL_WEBHOOK_URL=https://your-n8n-host/webhook/product-excel-upload

# ─────────────────────────────────────────────────────────────────
# Auth UI
# Public path for the login card logo shown above the sign-in form.
# ─────────────────────────────────────────────────────────────────
VITE_LOGIN_LOGO_SRC=/logo-ekowattsg.svg
# Show or hide username/password + sign-in button block on login page.
# true  = show credentials block
# false = hide credentials block (OTP + QR still available)
VITE_SHOW_CREDENTIAL_LOGIN_BLOCK=true
